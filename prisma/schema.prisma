generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id            String   @id @default(cuid())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  username      String
  email         String   @unique
  clerk_user_id String   @unique

  conversations_first_user  Conversation[] @relation("conversations_first_user")
  conversations_second_user Conversation[] @relation("conversations_second_user")

  messages Message[]
}

model Conversation {
  id String @id @default(cuid())

  first_user_id  String
  second_user_id String

  user1 User @relation("conversations_first_user", fields: [first_user_id], references: [id], onDelete: Cascade)
  user2 User @relation("conversations_second_user", fields: [second_user_id], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([first_user_id, second_user_id])
  @@index([first_user_id])
  @@index([second_user_id])
}

model Message {
  id String @id @default(cuid())

  conversation_id String
  sender_id       String

  content String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
}
